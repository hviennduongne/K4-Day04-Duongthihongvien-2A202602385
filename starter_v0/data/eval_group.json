  "cases": [
    {
      "id": "G01_missing_asset_clarify",
      "phase": "B",
      "suite": "group",
      "query": "Máy tính của tôi không in được tài liệu, hãy kiểm tra phần cứng giúp tôi.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_asset",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu kiểm tra phần cứng thiết bị nhưng thiếu mã asset_id, phải hỏi lại bằng clarify response_type=text."
      }
    },
    {
